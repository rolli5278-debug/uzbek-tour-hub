# Netlify → Project configuration → Environment variables bo'limiga kiriting (bu fayl faqat namuna).
# Kalitlarni hech qachon kodga yoki shu faylga yozmang.

# AI agent (Anthropic Claude). Kalit: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Ixtiyoriy. Standart: claude-haiku-5-5
ANTHROPIC_MODEL=

# Booking.com Demand API: shahar sahifasidagi mehmonxona narxlari va ekskursiyalar (Attractions), AI agent
BOOKING_AFFILIATE_ID=
BOOKING_API_TOKEN=
# Ixtiyoriy: sandbox — https://demandapi-sandbox.booking.com/3.2 ; valyuta (standart USD)
BOOKING_API_BASE=
BOOKING_CURRENCY=

# Ixtiyoriy: reyting ovoz kalitlari uchun maxfiy "tuz" (IP ochiq saqlanmaydi)
RATING_SALT=

# Bron va gid so'rovlari shu Telegram chatga keladi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel (/admin/) — MAXFIY qiling (Netlify: "Contains secret values")
ADMIN_USER=admin
ADMIN_PASSWORD=
# ixtiyoriy: sessiya imzosi uchun qo'shimcha maxfiy kalit (uzun tasodifiy satr)
ADMIN_SECRET=
